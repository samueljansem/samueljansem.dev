---
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;

// Strip locale prefix to get the base path
const basePath = lang === "en" ? currentPath : currentPath.replace(/^\/pt-br/, "") || "/";

const enPath = getLocalizedPath(basePath, "en");
const ptPath = getLocalizedPath(basePath, "pt-br");
---

<div class="flex items-center gap-1 text-sm font-medium">
  <a
    href={enPath}
    class:list={[
      "px-1 underline-offset-4",
      lang === "en" ? "underline font-bold" : "zag-muted hover:underline",
    ]}
  >
    EN
  </a>
  <span class="zag-muted">|</span>
  <a
    href={ptPath}
    class:list={[
      "px-1 underline-offset-4",
      lang === "pt-br" ? "underline font-bold" : "zag-muted hover:underline",
    ]}
  >
    PT
  </a>
</div>
