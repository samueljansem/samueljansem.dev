---
import type { ProjectFrontmatter } from "../../lib/types";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils";
import Anchor from "../common/Anchor.astro";
import ProjectSnippet from "../ProjectSnippet.astro";

type Props = {
	featuredProjects: Array<ProjectFrontmatter>;
};

const { featuredProjects } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="flex justify-between items-center w-full">
  <h3 class="font-display text-lg sm:text-xl leading-loose">{t("section.projects")}</h3>
  <Anchor url={getLocalizedPath("/projects", lang)} class="text-base">{t("section.viewAll")}</Anchor>
</div>
<ul class="my-8">
  {
    (featuredProjects.length === 0 && <p>{t("section.noProjects")}</p>) ||
      featuredProjects.map((project) => (
        <li>
          <ProjectSnippet
            title={project.title}
            description={project.description}
            url={project.url}
            githubUrl={project.githubUrl}
            liveUrl={project.liveDemoUrl}
            tags={project.tags ?? []}
          />
        </li>
      ))
  }
</ul>
