---
import Anchor from "../components/common/Anchor.astro";
import Section from "../components/common/Section.astro";
import Layout from "../layouts/Layout.astro";
import { getConfigurationCollection } from "../lib/utils";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const { data: config } = await getConfigurationCollection();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const email = "samuel@samueljansem.dev";
const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(t("contact.subject"))}`;
---

<Layout>
  <Fragment slot="head">
    <title>{config.contactMeta.title}</title>
    <meta
      name="description"
      content={config.contactMeta.longDescription ?? config.contactMeta.description}
    />
    <meta property="og:title" content={config.contactMeta.title} />
    <meta property="og:description" content={config.contactMeta.description} />
    {config.contactMeta.keywords && (
      <meta name="keywords" content={config.contactMeta.keywords.join(", ")} />
    )}
    {config.contactMeta.cardImage && (
      <meta property="og:image" content={config.contactMeta.cardImage} />
    )}
    <meta property="og:url" content={`${config.site.baseUrl}/contact`} />
    <link rel="canonical" href={`${config.site.baseUrl}/contact`} />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">{t("page.contact.title")}</h1>
    </div>

    <p class="zag-text zag-transition leading-relaxed mb-8">{t("contact.intro")}</p>

    <div class="mb-12">
      <a
        href={mailtoUrl}
        class="-zag-bg -zag-text zag-transition font-display px-6 py-3 inline-block text-sm hover:opacity-80"
      >
        {t("contact.cta")}
      </a>
    </div>

    <div>
      <p class="zag-text zag-transition mb-4">{t("contact.social")}</p>
      <div class="flex gap-4">
        {
          config.personal.githubProfile && (
            <Anchor url={config.personal.githubProfile} external>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                class="zag-fill zag-transition"
              >
                <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2" />
              </svg>
              GitHub
            </Anchor>
          )
        }
        {
          config.personal.linkedinProfile && (
            <Anchor url={config.personal.linkedinProfile} external>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                class="zag-fill zag-transition"
              >
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93zM6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37z" />
              </svg>
              LinkedIn
            </Anchor>
          )
        }
      </div>
    </div>
  </Section>
</Layout>
