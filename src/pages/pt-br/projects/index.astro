---
import { getCollection } from "astro:content";
import Section from "../../../components/common/Section.astro";
import ProjectSnippet from "../../../components/ProjectSnippet.astro";
import Timeline from "../../../components/timeline/Timeline.astro";
import TimelineItem from "../../../components/timeline/TimelineItem.astro";
import Layout from "../../../layouts/Layout.astro";
import { getConfigurationCollection, processArticleDate } from "../../../lib/utils";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const projects = (await getCollection("project", (e) => e.data.lang === "pt-br")).sort(
	(a, b) => b.data.timestamp.valueOf() - a.data.timestamp.valueOf(),
);

const { data: config } = await getConfigurationCollection();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
  <Fragment slot="head">
    <title>{config.projectMeta.title}</title>
    <meta
      name="description"
      content={config.projectMeta.longDescription ?? config.projectMeta.description}
    />
    <meta property="og:title" content={config.projectMeta.title} />
    <meta property="og:description" content={config.projectMeta.description} />
    {config.projectMeta.cardImage && (
      <meta property="og:image" content={config.projectMeta.cardImage} />
    )}
    <meta property="og:url" content={`${config.site.baseUrl}/pt-br/projects`} />
    <link rel="canonical" href={`${config.site.baseUrl}/pt-br/projects`} />
  </Fragment>
  <Section class="py-4 my-8">
    <div class="flex items-center gap-4 pt-8 pb-16">
      <h1 class="font-display text-3xl sm:text-4xl leading-loose">{t("page.projects.title")}</h1>
    </div>
    <Timeline>
      {
        projects.map((project) => (
          <TimelineItem date={processArticleDate(project.data.timestamp)}>
            <ProjectSnippet
              title={project.data.title}
              description={project.data.description}
              url={`/pt-br/projects/${project.data.slug}`}
              githubUrl={project.data.githubUrl}
              liveUrl={project.data.liveDemoUrl}
              tags={project.data.tags ?? []}
            />
          </TimelineItem>
        ))
      }
    </Timeline>
  </Section>
</Layout>
